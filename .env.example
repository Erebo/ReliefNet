# Database Configuration (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://reliefnet:reliefnet123@localhost:5432/reliefnet_db
# Fallback SQLite DB URL for local development/testing without Docker:
# DATABASE_URL=sqlite:///./reliefnet.db

# Server & Security
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]
JWT_SECRET=super-secret-reliefnet-jwt-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SMS Provider Integration (Mock Provider used by default for MVP)
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_API_SECRET=
SMS_FROM_NUMBER=+8801700000000
SMS_WEBHOOK_SECRET=

# Map Configuration
MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
